<UserControl x:Class="BAKeySmith.App.Controls.MacroEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="220">
    <UserControl.Resources>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748b" />
        <SolidColorBrush x:Key="LineBrush" Color="#dbe4ef" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0f766e" />
        <SolidColorBrush x:Key="DangerBrush" Color="#b91c1c" />
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="Background" Value="#e2e8f0" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="LineNumberViewport"
                    VerticalAlignment="Top"
                    Background="#e2e8f0"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1,1,0,1"
                    ClipToBounds="True">
                <Canvas x:Name="LineNumberCanvas" />
            </Border>
            <TextBox x:Name="ScriptBox"
                     Grid.Column="1"
                     AcceptsReturn="True"
                     AcceptsTab="False"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono"
                     FontSize="12"
                     InputMethod.IsInputMethodEnabled="False"
                     VerticalContentAlignment="Top"
                     Height="132"
                     SelectionChanged="ScriptBox_SelectionChanged"
                     PreviewKeyDown="ScriptBox_PreviewKeyDown"
                     TextChanged="ScriptBox_TextChanged" />
            <Popup x:Name="CompletionPopup"
                   Grid.Column="1"
                   PlacementTarget="{Binding ElementName=ScriptBox}"
                   Placement="Relative"
                   AllowsTransparency="True"
                   Focusable="False"
                   StaysOpen="True"
                   PopupAnimation="Fade">
                <Border x:Name="CompletionPopupBorder"
                        Background="White"
                        BorderBrush="#94a3b8"
                        BorderThickness="1"
                        Padding="4"
                        MaxHeight="172">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12"
                                          ShadowDepth="2"
                                          Opacity="0.18" />
                    </Border.Effect>
                    <ListBox x:Name="CompletionList"
                             MinWidth="220"
                             MaxWidth="360"
                             MaxHeight="160"
                             DisplayMemberPath="Display"
                             FontFamily="Cascadia Mono"
                             FontSize="12"
                             KeyboardNavigation.TabNavigation="Continue"
                             PreviewKeyDown="CompletionList_PreviewKeyDown"
                             MouseDoubleClick="CompletionList_MouseDoubleClick" />
                </Border>
            </Popup>
        </Grid>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       Text="macro ok"
                       Foreground="{StaticResource AccentBrush}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="CursorText"
                       Grid.Column="1"
                       Foreground="{StaticResource MutedBrush}"
                       Margin="12,0,0,0" />
        </Grid>

        <Border Margin="0,8,0,0"
                Padding="10,8"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                Background="#f8fafc">
            <TextBlock x:Name="TokenPreviewText"
                       FontFamily="Cascadia Mono"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>

    </StackPanel>
</UserControl>
