<UserControl x:Class="BAKeySmith.App.Controls.MacroEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="220">
    <UserControl.Resources>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748b" />
        <SolidColorBrush x:Key="LineBrush" Color="#dbe4ef" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0f766e" />
        <SolidColorBrush x:Key="DangerBrush" Color="#b91c1c" />
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="Background" Value="#e2e8f0" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#e2e8f0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,1,0,1">
                <TextBlock x:Name="LineNumbersText"
                           Text="1"
                           Padding="8,10"
                           Foreground="{StaticResource MutedBrush}"
                           FontFamily="Cascadia Mono"
                           FontSize="12"
                           TextAlignment="Right" />
            </Border>
            <TextBox x:Name="ScriptBox"
                     Grid.Column="1"
                     AcceptsReturn="True"
                     AcceptsTab="False"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono"
                     Height="132"
                     SelectionChanged="ScriptBox_SelectionChanged"
                     PreviewKeyDown="ScriptBox_PreviewKeyDown"
                     TextChanged="ScriptBox_TextChanged" />
        </Grid>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       Text="macro ok"
                       Foreground="{StaticResource AccentBrush}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="CursorText"
                       Grid.Column="1"
                       Foreground="{StaticResource MutedBrush}"
                       Margin="12,0,0,0" />
        </Grid>

        <Border Margin="0,8,0,0"
                Padding="10,8"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                Background="#f8fafc">
            <TextBlock x:Name="TokenPreviewText"
                       FontFamily="Cascadia Mono"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>

        <ListBox x:Name="DiagnosticList"
                 Margin="0,8,0,0"
                 Height="54"
                 DisplayMemberPath="Display"
                 FontFamily="Cascadia Mono"
                 FontSize="12"
                 Visibility="Collapsed"
                 MouseDoubleClick="DiagnosticList_MouseDoubleClick" />

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="SuggestionList"
                     Height="82"
                     DisplayMemberPath="Display"
                     FontFamily="Cascadia Mono"
                     FontSize="12"
                     MouseDoubleClick="SuggestionList_MouseDoubleClick" />
            <Button Grid.Column="1"
                    Content="插入补全"
                    Click="InsertCompletion_Click"
                    Margin="10,0,0,0" />
        </Grid>
    </StackPanel>
</UserControl>
