<Window x:Class="BAKeySmith.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BAKeySmith.App.Controls"
        Title="BA KeySmith Next" Width="1040" Height="720"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        Background="#0f172a">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#172033"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748b"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#f8fafc"/>
        <SolidColorBrush x:Key="LineBrush" Color="#dbe4ef"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0f766e"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#115e59"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#b91c1c"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentDarkBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#94a3b8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#e2e8f0" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0f172a" Offset="0" />
                <GradientStop Color="#123b4d" Offset="0.52" />
                <GradientStop Color="#f4f7fb" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="BA KeySmith Next" Foreground="White" FontSize="34" FontWeight="Black" />
                    <TextBlock Text="runtime contract first · safe dry-run shell" Foreground="#c8f5ef" FontSize="14" Margin="2,6,0,0" />
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#d9fff8" CornerRadius="18" Padding="16,9" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="Stopped" Foreground="#115e59" FontWeight="Bold" />
                </Border>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="运行配置" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="默认 dry-run，不会发送真实输入。Live 模式需要显式勾选。" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,16" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ConfigPathBox" />
                                <Button Grid.Column="1" Content="选择" Style="{StaticResource GhostButton}" Click="BrowseConfig_Click" Margin="10,0,0,0" />
                            </Grid>

                            <UniformGrid Columns="3" Margin="0,14,0,0">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="目标进程" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="TargetProcessBox" Text="BlueArchive.exe" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="开关热键" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="HotkeyBox" Text="ctrl+shift+f12" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Tap 持续(ms)" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="TapHoldBox" Text="20" />
                                </StackPanel>
                            </UniformGrid>

                            <WrapPanel Margin="0,18,0,0">
                                <CheckBox x:Name="DryRunCheck" Content="Dry-run 安全模式" IsChecked="True" VerticalAlignment="Center" Margin="0,0,18,0" Checked="ModeCheck_Changed" Unchecked="ModeCheck_Changed" />
                                <CheckBox x:Name="AllowForegroundCheck" Content="允许任意前台窗口" IsChecked="True" VerticalAlignment="Center" />
                            </WrapPanel>

                            <TextBlock x:Name="LiveWarningText"
                                       Text="Live 模式会安装全局 hook 并发送真实输入，请只在准备测试时启用。"
                                       Foreground="{StaticResource DangerBrush}"
                                       FontWeight="Bold"
                                       Visibility="Collapsed"
                                       Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="控制台" FontSize="20" FontWeight="Bold" />
                            <WrapPanel Margin="0,16,0,0">
                                <Button x:Name="StartButton" Content="启动 Runtime" Click="Start_Click" />
                                <Button x:Name="StopButton" Content="停止" Style="{StaticResource DangerButton}" Click="Stop_Click" IsEnabled="False" />
                                <Button Content="重新加载配置" Style="{StaticResource GhostButton}" Click="Reload_Click" />
                            </WrapPanel>

                            <UniformGrid Columns="3" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="映射数量" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="MappingCountText" Text="0" FontSize="26" FontWeight="Black" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="目标进程" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="TargetText" Text="-" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="输入事件" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="InputEventCountText" Text="0" FontSize="26" FontWeight="Black" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Dry-run 模拟触发" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="示例：q down / q up / mouse_right down" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,14" />
                            <WrapPanel>
                                <TextBox x:Name="SimulateCodeBox" Width="180" Text="q" />
                                <Button Content="Down" Click="SimulateDown_Click" Margin="10,0,10,0" />
                                <Button Content="Up" Style="{StaticResource GhostButton}" Click="SimulateUp_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0">
                    <TabControl Background="Transparent" BorderThickness="0">
                        <TabItem Header="映射编辑">
                            <Grid Margin="0,18,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Mappings" FontSize="20" FontWeight="Bold" />
                                        <TextBlock Text="编辑后保存配置；Runtime 运行中会自动 reload。" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <WrapPanel DockPanel.Dock="Right">
                                        <Button Content="从文件加载" Style="{StaticResource GhostButton}" Click="LoadConfig_Click" />
                                        <Button Content="保存配置" Click="SaveConfig_Click" />
                                    </WrapPanel>
                                </DockPanel>

                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="0.9*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="1.05*" />
                                    </Grid.RowDefinitions>

                                    <DataGrid x:Name="MappingsGrid"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              SelectionMode="Single"
                                              SelectionChanged="MappingsGrid_SelectionChanged"
                                              BorderBrush="{StaticResource LineBrush}"
                                              BorderThickness="1"
                                              HeadersVisibility="Column"
                                              RowHeaderWidth="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Trigger" Binding="{Binding Trigger}" Width="1.1*" />
                                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="0.8*" />
                                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="1*" />
                                            <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="0.8*" />
                                            <DataGridTextColumn Header="Script" Binding="{Binding ScriptSummary}" Width="1.6*" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Grid Grid.Row="2" Margin="0,16,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,10">
                                            <TextBlock Text="触发键" Foreground="{StaticResource MutedBrush}" />
                                            <TextBox x:Name="MappingTriggerBox" Text="q" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,10,10">
                                            <TextBlock Text="类型" Foreground="{StaticResource MutedBrush}" />
                                            <ComboBox x:Name="MappingTypeCombo" SelectionChanged="MappingTypeCombo_SelectionChanged" Padding="10,8">
                                                <ComboBoxItem Content="simple" IsSelected="True" />
                                                <ComboBoxItem Content="macro" />
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="0,0,0,10">
                                            <TextBlock Text="模式" Foreground="{StaticResource MutedBrush}" />
                                            <ComboBox x:Name="MappingModeCombo" Padding="10,8">
                                                <ComboBoxItem Content="hold" IsSelected="True" />
                                                <ComboBoxItem Content="tap" />
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,10">
                                            <TextBlock Text="目标键（simple）" Foreground="{StaticResource MutedBrush}" />
                                            <TextBox x:Name="MappingTargetBox" Text="1" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                                            <TextBlock Text="宏脚本（macro）" Foreground="{StaticResource MutedBrush}" />
                                            <controls:MacroEditorControl x:Name="MacroEditor" ScriptText="loop 2&#x0a;tap esc&#x0a;end" />
                                        </StackPanel>

                                        <WrapPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,14,0,0">
                                            <Button Content="新增" Click="AddMapping_Click" />
                                            <Button Content="更新选中" Style="{StaticResource GhostButton}" Click="UpdateMapping_Click" />
                                            <Button Content="删除选中" Style="{StaticResource DangerButton}" Click="RemoveMapping_Click" />
                                            <Button Content="清空表单" Style="{StaticResource GhostButton}" Click="ClearMappingForm_Click" />
                                        </WrapPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Diagnostics">
                            <Grid Margin="0,18,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <StackPanel>
                                        <TextBlock Text="Diagnostics" FontSize="20" FontWeight="Bold" />
                                        <TextBlock Text="runtime snapshot / foreground probe / ownership events" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <WrapPanel DockPanel.Dock="Right">
                                        <Button Content="刷新状态" Style="{StaticResource GhostButton}" Click="RefreshStatus_Click" />
                                        <Button Content="前台判定" Style="{StaticResource GhostButton}" Click="ProbeForeground_Click" />
                                        <Button Content="清空" Style="{StaticResource GhostButton}" Click="ClearLog_Click" />
                                    </WrapPanel>
                                </DockPanel>

                                <Border Grid.Row="1"
                                        Margin="0,16,0,0"
                                        Padding="16"
                                        Background="#eefbf8"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="18">
                                    <StackPanel>
                                        <UniformGrid Columns="4">
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Host" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock x:Name="HostStartedText" Text="stopped" FontSize="18" FontWeight="Black" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Runtime" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock x:Name="RuntimeStateText" Text="Stopped" FontSize="18" FontWeight="Black" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Pipeline" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock x:Name="PipelineStateText" Text="stopped" FontSize="18" FontWeight="Black" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Foreground" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock x:Name="ForegroundStateText" Text="unknown" FontSize="18" FontWeight="Black" />
                                            </StackPanel>
                                        </UniformGrid>

                                        <UniformGrid Columns="6" Margin="0,14,0,0">
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Generation" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock x:Name="GenerationText" Text="0" FontSize="18" FontWeight="Black" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Workers" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock x:Name="WorkerCountText" Text="0" FontSize="18" FontWeight="Black" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Pending" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock x:Name="PendingActionCountText" Text="0" FontSize="18" FontWeight="Black" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Running" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock x:Name="RunningActionCountText" Text="0" FontSize="18" FontWeight="Black" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Held Keys" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock x:Name="HeldKeyCountText" Text="0" FontSize="18" FontWeight="Black" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Owners" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock x:Name="OwnerCountText" Text="0" FontSize="18" FontWeight="Black" />
                                            </StackPanel>
                                        </UniformGrid>

                                        <TextBox x:Name="SnapshotDetailsBox"
                                                 Margin="0,14,0,0"
                                                 Height="82"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 FontFamily="Cascadia Mono"
                                                 FontSize="12" />
                                        <TextBlock x:Name="ForegroundProbeText"
                                                   Text="前台判定尚未刷新"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>

                                <ListBox x:Name="DiagnosticsList"
                                         Grid.Row="2"
                                         Margin="0,18,0,0"
                                         Background="#0b1220"
                                         Foreground="#d6f7f1"
                                         BorderThickness="0"
                                         FontFamily="Cascadia Mono"
                                         FontSize="12" />
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
