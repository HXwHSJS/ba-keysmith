<Window x:Class="BAKeySmith.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BAKeySmith.App.Controls"
        Title="BA KeySmith Next" Width="1280" Height="760"
        MinWidth="1240" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        Background="#0f172a">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#172033"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748b"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#f8fafc"/>
        <SolidColorBrush x:Key="LineBrush" Color="#dbe4ef"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0f766e"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#115e59"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#b91c1c"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentDarkBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#94a3b8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#e2e8f0" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0f172a" Offset="0" />
                <GradientStop Color="#123b4d" Offset="0.52" />
                <GradientStop Color="#f4f7fb" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="BA KeySmith Next" Foreground="White" FontSize="34" FontWeight="Black" />
                    <TextBlock Text="runtime contract first · safe dry-run shell" Foreground="#c8f5ef" FontSize="14" Margin="2,6,0,0" />
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#d9fff8" CornerRadius="18" Padding="16,9" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RuntimeStatus.StatusText}" Foreground="#115e59" FontWeight="Bold" />
                </Border>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" MinWidth="560" />
                    <ColumnDefinition Width="1.1*" MinWidth="590" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0"
                              Margin="0,0,18,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="运行配置" FontSize="20" FontWeight="Bold" />
                                <TextBlock Text="默认 dry-run，不会发送真实输入。Live 模式需要显式勾选。" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,16" />

                                <Grid MinWidth="500">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ConfigPathBox" Text="{Binding ConfigPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="选择" Style="{StaticResource GhostButton}" Click="BrowseConfig_Click" Margin="10,0,0,0" />
                                </Grid>

                                <UniformGrid Columns="3" MinWidth="500" Margin="0,14,0,0">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="目标进程" Foreground="{StaticResource MutedBrush}" />
                                        <TextBox x:Name="TargetProcessBox" Text="{Binding TargetProcess, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="开关热键" Foreground="{StaticResource MutedBrush}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="HotkeyBox" Text="{Binding Hotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button x:Name="HotkeyCaptureButton"
                                                    Grid.Column="1"
                                                    Content="捕获"
                                                    Style="{StaticResource GhostButton}"
                                                    Padding="10,9"
                                                    Margin="8,0,0,0"
                                                    Click="BeginHotkeyCapture_Click" />
                                            <Button x:Name="HotkeyCancelCaptureButton"
                                                    Grid.Column="2"
                                                    Content="取消"
                                                    Style="{StaticResource GhostButton}"
                                                    Padding="10,9"
                                                    Margin="6,0,0,0"
                                                    IsEnabled="{Binding IsCapturingHotkey}"
                                                    Click="CancelKeyCapture_Click" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Tap 持续(ms)" Foreground="{StaticResource MutedBrush}" />
                                        <TextBox x:Name="TapHoldBox" Text="{Binding TapHoldMilliseconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>

                                <WrapPanel Margin="0,18,0,0">
                                    <CheckBox x:Name="DryRunCheck" Content="Dry-run 安全模式" IsChecked="{Binding IsDryRun, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,18,0" Checked="ModeCheck_Changed" Unchecked="ModeCheck_Changed" />
                                    <CheckBox x:Name="AllowForegroundCheck" Content="允许任意前台窗口" IsChecked="{Binding AllowAnyForeground, Mode=TwoWay}" VerticalAlignment="Center" />
                                </WrapPanel>

                                <TextBlock x:Name="LiveWarningText"
                                           Text="Live 模式会安装全局 hook 并发送真实输入，请只在准备测试时启用。"
                                           Foreground="{StaticResource DangerBrush}"
                                           FontWeight="Bold"
                                           Visibility="Collapsed"
                                           Margin="0,14,0,0" />

                                <TextBlock Text="{Binding KeyCaptureStatusText}"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0" />

                                <Border Margin="0,14,0,0"
                                        Padding="10,8"
                                        Background="#eefbf8"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ElevationStatusText}" FontWeight="Bold" />
                                        <TextBlock Text="{Binding ElevationHelpText}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="控制台" FontSize="20" FontWeight="Bold" />
                                <WrapPanel Margin="0,16,0,0">
                                    <Button x:Name="StartButton" Content="启动 Runtime" Command="{Binding StartRuntimeCommand}" />
                                    <Button x:Name="StopButton" Content="停止" Style="{StaticResource DangerButton}" Command="{Binding StopRuntimeCommand}" IsEnabled="False" />
                                    <Button Content="重新加载配置" Style="{StaticResource GhostButton}" Command="{Binding ReloadConfigCommand}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding LastError}"
                                           Foreground="{StaticResource DangerBrush}"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,0" />

                                <UniformGrid Columns="3" Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Text="映射数量" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock x:Name="MappingCountText" Text="{Binding MappingEditor.Mappings.Count}" FontSize="26" FontWeight="Black" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="目标进程" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="{Binding RuntimeStatus.TargetText}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="输入事件" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="{Binding RuntimeStatus.InputEventCountText}" FontSize="26" FontWeight="Black" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Dry-run 模拟触发" FontSize="20" FontWeight="Bold" />
                                <TextBlock Text="示例：q down / q up / mouse_right down" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,14" />
                                <WrapPanel>
                                    <TextBox Width="180" Text="{Binding SimulateCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Content="Down" Command="{Binding SimulateDownCommand}" Margin="10,0,10,0" />
                                    <Button Content="Up" Style="{StaticResource GhostButton}" Command="{Binding SimulateUpCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0">
                    <TabControl Background="Transparent" BorderThickness="0">
                        <TabItem Header="映射编辑">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                            <Grid MinWidth="520" Margin="0,18,8,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Mappings" FontSize="20" FontWeight="Bold" />
                                        <TextBlock Text="编辑后保存配置；Runtime 运行中会自动 reload。" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <WrapPanel DockPanel.Dock="Right">
                                        <Button Content="从文件加载" Style="{StaticResource GhostButton}" Click="LoadConfig_Click" />
                                        <Button Content="保存配置" Click="SaveConfig_Click" />
                                    </WrapPanel>
                                </DockPanel>

                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="0.9*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="1.05*" />
                                    </Grid.RowDefinitions>

                                    <DataGrid x:Name="MappingsGrid"
                                              ItemsSource="{Binding MappingEditor.Mappings}"
                                              SelectedItem="{Binding MappingEditor.SelectedMapping, Mode=TwoWay}"
                                              MaxHeight="190"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              SelectionMode="Single"
                                              BorderBrush="{StaticResource LineBrush}"
                                              BorderThickness="1"
                                              HeadersVisibility="Column"
                                              RowHeaderWidth="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Trigger" Binding="{Binding Trigger}" Width="1.1*" />
                                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="0.8*" />
                                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="1*" />
                                            <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="0.8*" />
                                            <DataGridTextColumn Header="Script" Binding="{Binding ScriptSummary}" Width="1.6*" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Grid Grid.Row="2" Margin="0,16,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,10">
                                            <TextBlock Text="触发键" Foreground="{StaticResource MutedBrush}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="MappingTriggerBox" Text="{Binding MappingEditor.EditingTrigger, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button x:Name="MappingTriggerCaptureButton"
                                                        Grid.Column="1"
                                                        Content="捕获"
                                                        Style="{StaticResource GhostButton}"
                                                        Padding="10,9"
                                                        Margin="8,0,0,0"
                                                        Click="BeginMappingTriggerCapture_Click" />
                                                <Button x:Name="MappingTriggerCancelCaptureButton"
                                                        Grid.Column="2"
                                                        Content="取消"
                                                        Style="{StaticResource GhostButton}"
                                                        Padding="10,9"
                                                        Margin="6,0,0,0"
                                                        IsEnabled="{Binding IsCapturingMappingTrigger}"
                                                        Click="CancelKeyCapture_Click" />
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,10,10">
                                            <TextBlock Text="类型" Foreground="{StaticResource MutedBrush}" />
                                            <ComboBox x:Name="MappingTypeCombo"
                                                      ItemsSource="{Binding MappingEditor.MappingTypes}"
                                                      SelectedItem="{Binding MappingEditor.EditingType, Mode=TwoWay}"
                                                      SelectionChanged="MappingTypeCombo_SelectionChanged"
                                                      Padding="10,8">
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="0,0,0,10">
                                            <TextBlock Text="模式" Foreground="{StaticResource MutedBrush}" />
                                            <ComboBox x:Name="MappingModeCombo"
                                                      ItemsSource="{Binding MappingEditor.MappingModes}"
                                                      SelectedItem="{Binding MappingEditor.EditingMode, Mode=TwoWay}"
                                                      Padding="10,8">
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,10">
                                            <TextBlock Text="目标键（simple）" Foreground="{StaticResource MutedBrush}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="MappingTargetBox" Text="{Binding MappingEditor.EditingTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button x:Name="MappingTargetCaptureButton"
                                                        Grid.Column="1"
                                                        Content="捕获"
                                                        Style="{StaticResource GhostButton}"
                                                        Padding="10,9"
                                                        Margin="8,0,0,0"
                                                        Click="BeginMappingTargetCapture_Click" />
                                                <Button x:Name="MappingTargetCancelCaptureButton"
                                                        Grid.Column="2"
                                                        Content="取消"
                                                        Style="{StaticResource GhostButton}"
                                                        Padding="10,9"
                                                        Margin="6,0,0,0"
                                                        IsEnabled="{Binding IsCapturingMappingTarget}"
                                                        Click="CancelKeyCapture_Click" />
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                                            <TextBlock Text="宏脚本（macro）" Foreground="{StaticResource MutedBrush}" />
                                            <controls:MacroEditorControl x:Name="MacroEditor" ScriptText="{Binding MappingEditor.EditingScript, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Border Margin="0,8,0,0"
                                                    Padding="10,8"
                                                    BorderBrush="{StaticResource LineBrush}"
                                                    BorderThickness="1"
                                                    Background="#f8fafc">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding MacroDiagnostics.Summary}"
                                                               FontWeight="Bold"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding MacroDiagnostics.FirstError}"
                                                               Foreground="{StaticResource DangerBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,4,0,0" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="Instructions: " Foreground="{StaticResource MutedBrush}" />
                                                        <TextBlock Text="{Binding MacroDiagnostics.InstructionCount}" Foreground="{StaticResource MutedBrush}" />
                                                        <TextBlock Text=" · Diagnostics: " Foreground="{StaticResource MutedBrush}" />
                                                        <TextBlock Text="{Binding MacroDiagnostics.DiagnosticCount}" Foreground="{StaticResource MutedBrush}" />
                                                    </StackPanel>
                                                    <ListBox x:Name="MacroDiagnosticsList"
                                                             ItemsSource="{Binding MacroDiagnostics.Diagnostics}"
                                                             DisplayMemberPath="Display"
                                                             Height="54"
                                                             Margin="0,6,0,0"
                                                             FontFamily="Cascadia Mono"
                                                             FontSize="12"
                                                             MouseDoubleClick="MacroDiagnosticsList_MouseDoubleClick" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <WrapPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,14,0,0">
                                            <Button Content="新增" Command="{Binding MappingEditor.AddCommand}" />
                                            <Button Content="更新选中" Style="{StaticResource GhostButton}" Command="{Binding MappingEditor.UpdateCommand}" />
                                            <Button Content="删除选中" Style="{StaticResource DangerButton}" Command="{Binding MappingEditor.RemoveCommand}" />
                                            <Button Content="清空表单" Style="{StaticResource GhostButton}" Command="{Binding MappingEditor.ClearCommand}" />
                                        </WrapPanel>
                                        <TextBlock Grid.Row="4"
                                                   Grid.ColumnSpan="3"
                                                   Text="{Binding MappingEditor.LastError}"
                                                   Foreground="{StaticResource DangerBrush}"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"
                                                   Margin="0,10,0,0" />
                                    </Grid>
                                </Grid>
                            </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Diagnostics">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                            <Grid MinWidth="520" Margin="0,18,8,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <StackPanel>
                                        <TextBlock Text="Diagnostics" FontSize="20" FontWeight="Bold" />
                                        <TextBlock Text="runtime snapshot / foreground probe / ownership events" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <WrapPanel DockPanel.Dock="Right">
                                        <Button Content="刷新状态" Style="{StaticResource GhostButton}" Command="{Binding RefreshStatusCommand}" />
                                        <Button Content="前台判定" Style="{StaticResource GhostButton}" Command="{Binding ProbeForegroundCommand}" />
                                        <Button Content="清空" Style="{StaticResource GhostButton}" Command="{Binding ClearDiagnosticsCommand}" />
                                    </WrapPanel>
                                </DockPanel>

                                <Border Grid.Row="1"
                                        Margin="0,16,0,0"
                                        Padding="16"
                                        Background="#eefbf8"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="18">
                                    <StackPanel>
                                        <WrapPanel ItemWidth="124">
                                            <StackPanel Margin="0,0,12,12">
                                                <TextBlock Text="Host" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="{Binding RuntimeStatus.HostStartedText}" FontSize="18" FontWeight="Black" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,12">
                                                <TextBlock Text="Runtime" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="{Binding RuntimeStatus.RuntimeStateText}" FontSize="18" FontWeight="Black" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,12">
                                                <TextBlock Text="Pipeline" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="{Binding RuntimeStatus.PipelineStateText}" FontSize="18" FontWeight="Black" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock Text="Foreground" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="{Binding RuntimeStatus.ForegroundStateText}" FontSize="18" FontWeight="Black" />
                                            </StackPanel>
                                        </WrapPanel>

                                        <WrapPanel ItemWidth="92" Margin="0,2,0,0">
                                            <StackPanel Margin="0,0,12,12">
                                                <TextBlock Text="Generation" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="{Binding RuntimeStatus.GenerationText}" FontSize="18" FontWeight="Black" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,12">
                                                <TextBlock Text="Workers" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="{Binding RuntimeStatus.WorkerCountText}" FontSize="18" FontWeight="Black" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,12">
                                                <TextBlock Text="Pending" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="{Binding RuntimeStatus.PendingActionCountText}" FontSize="18" FontWeight="Black" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,12">
                                                <TextBlock Text="Running" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="{Binding RuntimeStatus.RunningActionCountText}" FontSize="18" FontWeight="Black" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,12">
                                                <TextBlock Text="Held Keys" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="{Binding RuntimeStatus.HeldKeyCountText}" FontSize="18" FontWeight="Black" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock Text="Owners" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="{Binding RuntimeStatus.OwnerCountText}" FontSize="18" FontWeight="Black" />
                                            </StackPanel>
                                        </WrapPanel>

                                        <TextBox x:Name="SnapshotDetailsBox"
                                                 Margin="0,14,0,0"
                                                 Height="82"
                                                 IsReadOnly="True"
                                                 Text="{Binding RuntimeStatus.SnapshotDetailsText, Mode=OneWay}"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 FontFamily="Cascadia Mono"
                                                 FontSize="12" />
                                        <TextBlock x:Name="ForegroundProbeText"
                                                   Text="{Binding ForegroundProbe.Display}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>

                                <ListBox x:Name="DiagnosticsList"
                                         Grid.Row="2"
                                         Margin="0,18,0,0"
                                         ItemsSource="{Binding DiagnosticsLog.Entries}"
                                         DisplayMemberPath="Display"
                                         MinHeight="180"
                                         Background="#0b1220"
                                         Foreground="#d6f7f1"
                                         BorderThickness="0"
                                         FontFamily="Cascadia Mono"
                                         FontSize="12" />
                            </Grid>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
